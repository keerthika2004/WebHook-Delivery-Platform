<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- Spring Boot's parent POM gives us tested, compatible versions for Spring,
         Kafka, Redis, Postgres, Flyway, HttpClient 5, JUnit 5, and Testcontainers
         so we don't have to guess version numbers by hand. -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/>
    </parent>

    <groupId>dev.hooklane</groupId>
    <artifactId>hooklane-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <!-- packaging=pom means this root project is an organizer for sub-modules, not a JAR itself -->
    <packaging>pom</packaging>

    <name>Hooklane</name>
    <description>Reliable webhook delivery platform (learning project)</description>

    <modules>
        <module>webhook-common</module>
        <module>chaos-receiver</module>
        <module>webhook-api</module>
        <module>webhook-worker</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <!-- Let sub-modules depend on webhook-common without repeating <version> everywhere -->
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>dev.hooklane</groupId>
                <artifactId>webhook-common</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>
